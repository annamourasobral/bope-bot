# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Client ID da aplicação (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=

# Opcional: ID do servidor (guild) para registrar comandos instantaneamente durante o desenvolvimento.
# Deixe vazio para registrar comandos globalmente (produção), o que pode levar até 1h para propagar.
GUILD_ID=

# Opcional: ID de um cargo extra com poderes de oficial. CAPITÃO, MAJOR, CORONEL e
# quem tem a permissão "Gerenciar Servidor" já são oficiais automaticamente.
OFFICER_ROLE_ID=

# String de conexão do Postgres (ex: Neon, Supabase, Render Postgres)
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=

# Definido automaticamente pelo Render em serviços Web (não precisa configurar manualmente)
PORT=

# Opcional: consulta o banco a cada X minutos para o Neon não hibernar (ver README)
DB_KEEPALIVE_MINUTES=
